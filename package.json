{
  "name": "ps5-local-host",
  "version": "0.3.0",
  "private": true,
  "description": "Local DNS and HTTPS host for user supplied web files",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "pack:mac": "electron-builder --mac dmg zip --publish=never",
    "pack:mac:zip": "electron-builder --mac zip",
    "pack:win": "electron-builder --win nsis portable --x64 --publish=never",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "dns-packet": "5.6.1",
    "node-forge": "1.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.ps5host.app",
    "productName": "PS5 Local Host",
    "asar": true,
    "files": [
      "src/**/*",
      "ui-prototype/index.html",
      "ui-prototype/styles.css",
      "ui-prototype/script.js",
      "assets/app-icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ]
  }
}
